# ==========================================
# 334GAME & RING OF FUTURE BACKEND CONFIG (.env.example)
# Copy this file to .env and fill in your actual credentials
# ==========================================

# TELEGRAM BOT INTEGRATION CONFIG
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_CHAT_ID=YOUR_ADMIN_TELEGRAM_CHAT_ID
TELEGRAM_ALERTS_ENABLED=true

# SUPABASE DATABASE CONFIG (Pure PostgreSQL Database Engine - No Supabase Auth)
SUPABASE_DB_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_REST_URL=https://your-project-id.supabase.co/rest/v1
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

SUPABASE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-id
SUPABASE_DB_PASS=your-db-password

# REDIS IN-MEMORY CACHE CONFIG
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# SECURITY & AUTH SECRETS (Custom App Auth System)
JWT_SECRET=your_jwt_secret_key
ADMIN_SECRET_KEY=your_admin_secret_key

# GAME CONFIGURATION
RTP_TARGET_PERCENT=95.0
BET_MIN_LIMIT=10.0
BET_MAX_LIMIT=10000.0
