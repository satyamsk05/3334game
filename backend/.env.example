# ==========================================
# BIT ARCADE GO BACKEND CONFIGURATION (.env)
# ==========================================

PORT=5050
CORS_ORIGIN=*

# PostgreSQL Database (Supabase or self-hosted)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/postgres?sslmode=disable

# Redis In-Memory Cache (Optional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Auth Secrets (REQUIRED - NO HARDCODED SECRETS)
JWT_SECRET=your_super_secure_jwt_secret_here_change_in_production
ADMIN_JWT_SECRET=your_super_secure_admin_jwt_secret_here_change_in_production

# Loggin.dev WhatsApp Authentication (From https://loggin.dev)
LOGGIN_APP_KEY=your_loggin_dev_app_key_here
