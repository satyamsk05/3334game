# Admin Panel Environment Variables
# Browser-side API (used by axios when not using rewrite)
NEXT_PUBLIC_API_URL=https://api.bitarcade.in/api/v1

# Server-side rewrite target (Next.js only — never expose to browser)
BACKEND_API_URL=https://api.bitarcade.in

# WebSocket (if used)
NEXT_PUBLIC_WS_URL=wss://api.bitarcade.in/ws
