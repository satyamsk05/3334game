# ==============================================================
# BIT ARCADE GO BACKEND PRODUCTION CONFIGURATION (.env)
# ==============================================================

PORT=5050
CORS_ORIGIN=*

# --------------------------------------------------------------
# 1. SUPABASE / POSTGRESQL DATABASE (REQUIRED)
# --------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
# Format 1 (Supabase Transaction Pooler - Port 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
#
# Format 2 (Supabase Direct Connection - Port 5432):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.your_project_id:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --------------------------------------------------------------
# 2. REDIS CACHE (OPTIONAL - Automatic In-Memory fallback if absent)
# --------------------------------------------------------------
# If running redis on AWS EC2 (sudo apt install -y redis-server):
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --------------------------------------------------------------
# 3. SECURITY & AUTH SECRETS (REQUIRED - Minimum 32 characters)
# --------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_change_this_to_32_characters_min
ADMIN_JWT_SECRET=super_secret_admin_jwt_key_change_this_to_32_characters_min

# --------------------------------------------------------------
# 4. ADMIN PORTAL LOGIN CREDENTIALS
# --------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_super_secure_password_1234

# --------------------------------------------------------------
# 5. WHATSAPP & CLIENT SETTINGS
# --------------------------------------------------------------
LOGGIN_APP_KEY=your_loggin_app_key_optional
BUSINESS_WHATSAPP_PHONE=919989907408
